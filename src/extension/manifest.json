{
  "manifest_version": 3,
  "name": "Music Sync",
  "version": "0.1.0",
  "description": "Lets this Mac's Music Sync agent control Spotify Web and YouTube Music Web.",
  "permissions": [
    "alarms",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "spotify.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "youtube-music.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://music.youtube.com/*"
  ]
}
